# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Default model for all labs (small, cheap, supports structured outputs)
OPENAI_MODEL=gpt-4o-mini

# Models compared in module1/step4_model_selection.py (comma separated)
OPENAI_COMPARE_MODELS=gpt-4o-mini,gpt-4o

# Request timeout in seconds and SDK retries for 429/5xx errors
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# DEBUG shows every request's latency and token usage
LOG_LEVEL=INFO
